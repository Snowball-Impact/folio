{
	"name": "folio-svelte-spike",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:managed": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ..\\tools\\start_svelte_dev.ps1",
		"diagnose:browser": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ..\\tools\\diagnose_browser_bridge.ps1",
		"preflight:uiux": "python ..\\tools\\uiux_preflight.py --require-server --strict",
		"test:ui": "playwright test --grep-invert @auth",
		"test:ui:auth": "playwright test --grep @auth --grep-invert @mutation",
		"test:ui:headed": "playwright test --headed --grep-invert @auth",
		"test:ui:report": "playwright show-report ..\\artifacts\\playwright\\report",
		"capture:ui": "node scripts/capture-ui.mjs",
		"test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
		"measure:routes": "node scripts/measure-route-performance.mjs",
		"performance:budget": "node scripts/check-performance-budget.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"smoke": "node scripts/smoke-cloudflare.mjs",
		"smoke:cloudflare": "node scripts/smoke-cloudflare.mjs",
		"smoke:supabase": "node scripts/smoke-supabase.mjs",
		"smoke:security": "node scripts/smoke-security.mjs",
		"preview:cloudflare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ..\\tools\\start_cloudflare_preview.ps1",
		"deploy:cloudflare": "wrangler pages deploy .svelte-kit/cloudflare",
		"verify": "npm.cmd run check && npm.cmd run build && npm.cmd run performance:budget && npm.cmd run smoke && npm.cmd run smoke:supabase && npm.cmd run smoke:security"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.112.3",
		"@tiptap/core": "^3.30.3",
		"@tiptap/extension-bubble-menu": "^3.30.3",
		"@tiptap/extension-color": "^3.30.3",
		"@tiptap/extension-font-family": "^3.30.3",
		"@tiptap/extension-highlight": "^3.30.3",
		"@tiptap/extension-image": "^3.30.3",
		"@tiptap/extension-link": "^3.30.3",
		"@tiptap/extension-mathematics": "^3.30.3",
		"@tiptap/extension-placeholder": "^3.30.3",
		"@tiptap/extension-subscript": "^3.30.3",
		"@tiptap/extension-superscript": "^3.30.3",
		"@tiptap/extension-text-align": "^3.30.3",
		"@tiptap/extension-text-style": "^3.30.3",
		"@tiptap/extension-underline": "^3.30.3",
		"@tiptap/pm": "^3.30.3",
		"@tiptap/starter-kit": "^3.30.3",
		"katex": "^0.18.4",
		"powerbi-client": "^2.24.1"
	}
}
