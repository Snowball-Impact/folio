{
	"name": "folio-svelte-spike",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"smoke": "node scripts/smoke-cloudflare.mjs",
		"smoke:cloudflare": "node scripts/smoke-cloudflare.mjs",
		"smoke:supabase": "node scripts/smoke-supabase.mjs",
		"smoke:security": "node scripts/smoke-security.mjs",
		"preview:cloudflare": "wrangler pages dev .svelte-kit/cloudflare --ip=127.0.0.1 --port=8788",
		"deploy:cloudflare": "wrangler pages deploy .svelte-kit/cloudflare",
		"verify": "npm.cmd run check && npm.cmd run build && npm.cmd run smoke && npm.cmd run smoke:supabase && npm.cmd run smoke:security"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.112.3",
		"powerbi-client": "^2.24.1"
	}
}