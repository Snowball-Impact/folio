SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional. Required only for server-side email notification delivery.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:8501
COOKIE_PASSWORD=replace-with-a-long-random-cookie-password
# Optional. Leave empty locally so local testing does not pollute production analytics.
GA_MEASUREMENT_ID=
# Optional. When all required SMTP values and SUPABASE_SERVICE_ROLE_KEY are set,
# FOLIO sends email for project comment notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FOLIO
SMTP_USE_TLS=true
