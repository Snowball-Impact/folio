PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy Streamlit/curation scripts can still read these fallback names.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional. Required only for server-side email notification delivery.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5173
COOKIE_PASSWORD=replace-with-a-long-random-cookie-password
# Optional. Required only for PBIX publishing and Power BI embedded token generation.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_API_BASE_URL=https://api.powerbi.com/v1.0/myorg
PBIX_MAX_UPLOAD_MB=50
POWERBI_IMPORT_POLL_SECONDS=100
POWERBI_CAPTURE_READY_WAIT_SECONDS=10
# Optional. Leave empty locally so local testing does not pollute production analytics.
GA_MEASUREMENT_ID=
# Optional. Public Supabase Storage bucket used for captured project thumbnails.
THUMBNAIL_STORAGE_BUCKET=project-thumbnails
# Optional. Required for Cloudflare Browser Rendering thumbnail capture.
THUMBNAIL_CAPTURE_ENABLED=true
THUMBNAIL_CAPTURE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=
# Optional. Set when local Playwright cannot discover Chrome or Chromium automatically.
CHROME_BINARY_PATH=
# Legacy Selenium tooling only.
CHROMEDRIVER_PATH=
# Optional. When all required SMTP values and SUPABASE_SERVICE_ROLE_KEY are set,
# FOLIO sends email for project comment notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FOLIO
SMTP_USE_TLS=true
